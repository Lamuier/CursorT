<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 背景：更纯净的浅色渐变 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="108"
                android:endY="108"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item
                    android:color="#FFFAFAF8"
                    android:offset="0" />
                <item
                    android:color="#FFF0EFED"
                    android:offset="0.6" />
                <item
                    android:color="#FFE8E6E0"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 中心柔光：增强主体立体感 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="48"
                android:type="radial">
                <item
                    android:color="#1860A5FA"
                    android:offset="0" />
                <item
                    android:color="#0060A5FA"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 右下微阴影：增加整体景深 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="68"
                android:centerY="72"
                android:gradientRadius="60"
                android:type="radial">
                <item
                    android:color="#10263A8A"
                    android:offset="0" />
                <item
                    android:color="#00263A8A"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>

<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 液体：75% 液位，更饱和透亮的蓝色渐变 -->
    <path android:pathData="M33.22,42 A24,24 0 1 0 74.78,42 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="54"
                android:endY="78"
                android:startX="54"
                android:startY="42"
                android:type="linear">
                <item
                    android:color="#FF60A5FA"
                    android:offset="0" />
                <item
                    android:color="#FF3B82F6"
                    android:offset="0.45" />
                <item
                    android:color="#FF1D4ED8"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 液面高光：表面张力弧线 -->
    <path
        android:fillColor="#33FFFFFF"
        android:pathData="M36.2,42 A20.2,20.2 0 0 0 71.8,42" />

    <!-- AI 星形光晕（半透明白色，营造发光感） -->
    <path
        android:fillColor="#4DFFFFFF"
        android:pathData="M54,43 C56.5,53 58.5,55 64,57 C58.5,59 56.5,61 54,71 C51.5,61 49.5,59 44,57 C49.5,55 51.5,53 54,43 Z" />

    <!-- AI 星形（更大更精致） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,47 C55.5,53 57,55.5 59,57 C57,58.5 55.5,61 54,68 C52.5,61 51,58.5 49,57 C51,55.5 52.5,53 54,47 Z" />

    <!-- 容器环：细、亮蓝渐变（由浅入深） -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,30 A24,24 0 1 1 53.99,30"
        android:strokeWidth="2.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="54"
                android:endY="78"
                android:startX="54"
                android:startY="30"
                android:type="linear">
                <item
                    android:color="#FF93C5FD"
                    android:offset="0" />
                <item
                    android:color="#FF3B82F6"
                    android:offset="0.4" />
                <item
                    android:color="#FF1E3A8A"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 环面高光弧（顶部左上方的柔光） -->
    <path
        android:fillColor="#00000000"
        android:pathData="M41,35.5 A24,24 0 0 1 64.5,35.5"
        android:strokeColor="#99FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.2" />
</vector>
